{
  "expo": {
    "name": "Dux AI",
    "slug": "dux-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A101D",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A101D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.duxai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.duxai.app"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Dux AI дауыспен сұрақ қою үшін микрофонды қолданады"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dux AI фото мен видеоны талдау үшін галереяға қол жеткізуді сұрайды",
          "cameraPermission": "Dux AI фото түсіру үшін камераны қолданады"
        }
      ]
    ]
  }
}
